{
  "name": "dsh-better-markdown",
  "version": "0.1.2",
  "description": "DeepSeek Harness Web plugin that renders streamed assistant Markdown with markstream-react.",
  "packageManager": "pnpm@10.33.3",
  "author": "duskzhen",
  "homepage": "https://github.com/zerob13/dsh-better-markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerob13/dsh-better-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/zerob13/dsh-better-markdown/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit && vitest run",
    "prepare": "pnpm run build"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-chat",
    "llm",
    "markdown",
    "markstream",
    "markstream-react",
    "streaming-markdown",
    "shiki",
    "syntax-highlighting",
    "react",
    "mermaid",
    "katex"
  ],
  "license": "MIT",
  "dependencies": {
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "katex": "^0.18.4",
    "markstream-react": "0.0.55",
    "mermaid": "11.16.1",
    "shiki": "4.4.3",
    "stream-markdown": "0.0.16"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stream-markdown-parser": "1.1.4",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.7-rc.1",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
